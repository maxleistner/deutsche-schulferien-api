{
  "version": 2,
  "name": "german-school-holidays-api",
  "functions": {
    "index.js": {
      "maxDuration": 10,
      "includeFiles": "{routes/**,public/**,lib/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
