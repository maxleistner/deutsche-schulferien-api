{
  "name": "schulferien-api",
  "version": "2.3.0",
  "description": "API für die Schulferien in Deutschland, filterbar nach Jahr und/oder Bundesland",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest tests/api.test.js",
    "test:data": "jest tests/data-validation.test.js",
    "test:v2": "jest tests/v2.test.js",
    "test:filters": "jest tests/filters.test.js",
    "test:system": "jest tests/system.test.js",
    "deploy": "npx vercel",
    "deploy:prod": "npx vercel --prod",
    "dev:vercel": "npx vercel dev",
    "test:ical": "jest tests/ical.test.js"
  },
  "author": "Maximilian Leistner (https://maxleistner.de)",
  "license": "Creative Commons Attribution 4.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "morgan": "^1.12.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "lib/*.js",
      "routes/**/*.js",
      "!node_modules/**"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
